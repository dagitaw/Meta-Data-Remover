{
  "name": "meta-data-remover",
  "version": "1.0.0",
  "description": "Metadata removal application",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.metadatarremover.app",
    "productName": "Metadata Remover",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "preload.js",
      "index.html",
      "scripts/**/*",
      "styles/**/*",
      "services/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
