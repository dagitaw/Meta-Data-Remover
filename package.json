{
  "name": "meta-data-remover",
  "version": "2.1.0",
  "description": "Remove metadata, convert media and remove image backgrounds — all offline.",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "selftest": "node tools/selftest.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "onnxruntime-node": "^1.22.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.metadatarremover.app",
    "productName": "Metadata Remover",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "preload.js",
      "index.html",
      "scripts/**/*",
      "styles/**/*",
      "services/**/*",
      "assets/**/*",
      "!node_modules/onnxruntime-node/bin/**/linux/**",
      "!node_modules/onnxruntime-node/bin/**/darwin/**",
      "!node_modules/onnxruntime-node/bin/**/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
